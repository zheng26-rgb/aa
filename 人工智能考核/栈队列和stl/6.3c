#include<stdio.h>
int main()
{
    int n;
    scanf("%d",&n);
    long long a[100];
    for(int i=1;i<=n;i++)
    {
        scanf("%lld",&a[i]);
    }
    for(int i=1;i<n;i++)
    {
        for(int j=1;j<n;j++)
        {
            if(a[j]>a[j+1])
            {
                long long temp=a[j];
                a[j]=a[j+1];
                a[j+1]=temp;
            }
        }
    }
    int found=0;
    for(int i=1;i<=n-2;i++)
    {
        if(a[i]+a[i+1]>a[i+2])
        {
            printf("%lld %lld %lld\n",a[i],a[i+1],a[i+2]);
            found=1;
            break;
        }
    }
    if(found==0)
    {
        printf("No solution");
    }
}