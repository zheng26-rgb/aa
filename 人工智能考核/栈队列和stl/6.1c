#include<stdio.h>
int n=8;
int path[10],used[10];
void dfs(int step)
{
    if(step==n)
    {
        for(int i=0;i<n;i++)
        {
            if(i==0)
            printf("%d",path[i]);
            else
                printf(" %d",path[i]);
        }
        printf("\n");
        return;
    }
    for(int i=1;i<=n;i++)
    {
        if(!used[i])
        {
            used[i]=1;
            path[step]=i;
            dfs(step+1);
            used[i]=0;
        }
    }
}
int main()
    {
        dfs(0);
    return 0;
    }