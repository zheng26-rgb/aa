#include<stdio.h>
#include<string.h>
int main()
{
    char s[100005];
    scanf("%s",s);
    int cnt=0;
    int f=1;
    for(int i=0;s[i]!='\0';i++)
    {
        if(s[i]=='a')
        {
            cnt++;
        }
        else
        {
            cnt--;
        }
        if(cnt<0)
        {
            f=0;
            break;
        }
    }
    if(f==1&&cnt==0)
    {
        printf("Good");
    }
    else
    {
        printf("Bad");
    }
}