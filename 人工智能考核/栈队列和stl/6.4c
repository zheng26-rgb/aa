#include<stdio.h>
#include<string.h>
char s[25][20];
char temp[20];
int main()
{
    int n;
    scanf("%d",&n);
    for(int i=1;i<=n;i++)
    {
        scanf("%s",s[i]);
    }
    for(int i=1;i<=n-1;i++)
    {
        for(int j=1;j<=n-i;j++)
        {
            char a[40],b[40];
            strcpy(a,s[j]);
            strcat(a,s[j+1]);
            strcpy(b,s[j+1]);
            strcat(b,s[j]);
            if(strcmp(a,b)<0)
            {
                strcpy(temp,s[j]);
                strcpy(s[j],s[j+1]);
                strcpy(s[j+1],temp);
            }
        }
    }
    for(int i=1;i<=n;i++)
    {
        printf("%s",s[i]);
    }
}
