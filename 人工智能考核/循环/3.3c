#include<stdio.h>
int main()
{
    char ch;
    scanf("%c",&ch);
    int n=ch-'A';
    for(int i=0;i<=n;i++)
    {
        for(int j=0;j<n-i;j++)
        {
            printf(" ");
        }
        for(int k=0;k<=i;k++)
        {
            printf("%c",'A'+k);
        }
        for(int k=i-1;k>=0;k--)
        {
            printf("%c",'A'+k);
        }
        printf("\n");
    }
}