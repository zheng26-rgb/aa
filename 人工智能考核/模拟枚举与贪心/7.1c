#include<stdio.h>
#include<string.h>
char s[200005];
int main()
{
    int n,t;
    scanf("%d %d",&n,&t);
    scanf("%s",s);
    int dot=-1;
    for(int i=0;i<n;i++)
    {
        if(s[i]=='.')
        {
            dot=i;
            break;
        }
    }
    if(dot==-1)
    {
        puts(s);
        return 0;
    }
   int pos=dot+1;
    while(pos<n&&t>0)
    {
        if(s[pos]>='5')
        {
            t--;
            pos--;
            while(pos>=0)
            {
                if(s[pos]=='.')
                {
                    pos--;
                    continue;
                }
                s[pos]++;
                if(s[pos]<='9')
                {
                    break;
                }
                s[pos]='0';
                pos--;
            }
            n=pos+1;
            pos--;
        }
        pos++;
    }
    int end=n-1;
    while(end>dot&&s[end]=='0')
        end--;
    if(s[end]=='.')
        end--;
    for(int i=0;i<=end;i++)
    {
        putchar(s[i]);
    }
}