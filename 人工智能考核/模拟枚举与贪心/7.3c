#include<stdio.h>
int main()
{
    char ch,next;
    int state=0;
    while((ch=getchar())!=EOF)
    {
        if(state==0)
        {
            if(ch=='"')
            {
                putchar(ch);
                state=1;
            }
            else if(ch=='/')
            {
                next=getchar();
                if(next=='*')
                {
                    state=2;
                }
                else
                {
                    putchar(ch);
                    if(next!=EOF)putchar(next);
                }
            }
            else
            {
                putchar(ch);
            }
        }
        else if(state==1)
        {
            if(ch=='\\')
            {
                putchar(ch);
                next=getchar();
                if(next!=EOF)putchar(next);
            }
            else if(ch=='"')
            {
                putchar(ch);
                state=0;
            }
            else
            {
                putchar(ch);
            }
        }
        else if(state==2)
        {
            if(ch=='*')
            {
                next=getchar();
                    if(next=='/')
                    {
                        state=0;
                    }
                else
                {
                    if(next!=EOF)
                    {
                        ungetc(next,stdin);
                    }
                }
            }
        }
    }
}
            