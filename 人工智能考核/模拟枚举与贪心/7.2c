#include<stdio.h>
#include<string.h>
int getmid(int a,int b)
{
    if(a==1&&b==3)
        return 2;
    if(a==3&&b==1)
        return 2;
    if(a==4&&b==6)
        return 5;
    if(a==6&&b==4)
        return 5;
    if(a==7&&b==9)
        return 8;
    if(a==9&&b==7)
        return 8;
    if(a==1&&b==7)
        return 4;
    if(a==7&&b==1)
        return 4;
    if(a==2&&b==8)return 5;
    if(a==8&&b==2)return 5;
    if(a==3&&b==9)return 6;
    if(a==9&&b==3)return 6;
    if(a==1&&b==9)return 5;
    if(a==9&&b==1)return 5;
    if(a==3&&b==7)return 5;
    if(a==7&&b==3)return 5;
    return 0;
}
int main()
{
    char s[35];
while(scanf("%s",s)!=EOF)
{
    int used[10]={0};
    int f=1;
    int len=strlen(s);
    int pre=s[0]-'0';
    used[pre]=1;
    for(int i=1;i<len;i++)
    {
        int cur=s[i]-'0';
        if(used[cur]==1)
        {
            f=0;
            break;
            
        }
        int mid=getmid(pre,cur);
        if(mid!=0&&used[mid]==0)
        {
            f=0;
            break;
        }
    used[cur]=1;
        pre=cur;
    }
    if(f==1)
        printf("YES\n");
    else
        printf("NO\n");
}
}
            