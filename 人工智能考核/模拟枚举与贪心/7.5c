#include<stdio.h>
char left[2000];
int cnt[10];
int main()
{
    int i,j;
    for(i=0;i<10;i++)
    {
        scanf("%d",&cnt[i]);
    }
    int total=0;
    for(i=0;i<10;i++) total+=cnt[i];
    if(total==cnt[0])
    {
        if(cnt[0]>0)
        {
            printf("0\n");
        }
        else
        {
            printf("-1\n");
        }
    } 
    int odd=0;
    int mid=-1;
    for(i=0;i<10;i++)
    {
        if(cnt[i]%2==1)
        {
            odd++;
            mid=i;
        }
    }
    if(odd>1)
    {
        printf("-1\n");
        return 0;
    }
    int p=0;
    for(i=0;i<=9;i++)
    {
        if(i==0&&p==0&&cnt[i]>=2)
        {
            continue;
        }
        int num=cnt[i]/2;
        for(j=0;j<num;j++)
        {
            left[p++]=i+'0';
        }
    }
    if(p==0)
    {
        if(mid!=-1)
            printf("0\n");
        else
            printf("-1\n");
        return 0;
    }
    for(i=0;i<p;i++)
        putchar(left[i]);
    if(mid!=-1)
        putchar(mid+'0');
    for(i=p-1;i>=0;i--)
        putchar(left[i]);
    putchar('\n');
    return 0;
}
        