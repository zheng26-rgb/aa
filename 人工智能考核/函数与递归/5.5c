#include<stdio.h>
#include<string.h>
int main()
{
    char s1[60],s2[60];
    int a[100]={0},b[100]={0},res[200]={0};
    int T;
    scanf("%d",&T);
    while(T--)
    {
        memset(a,0,sizeof(a));
        memset(b,0,sizeof(b));
        memset(res,0,sizeof(res));
        scanf("%s %s",s1,s2);
        int len1=strlen(s1);
        int len2=strlen(s2);
        int i,j;
        for(i=0;i<len1;i++)
            a[i]=s1[len1-1-i]-'0';
        for(i=0;i<len2;i++)
            b[i]=s2[len2-1-i]-'0';
        for(i=0;i<len2;i++)
        {
            for(j=0;j<len2;j++)
            {
            res[i+j]+=a[i]*b[j];
            res[i+j+1]+=res[i+j]/10;
            res[i+j]=res[i+j]%10;
            }
        }
    int p=len1+len2-1;
    while(p>0&&res[p]==0)p--;
    for(;p>=0;p--)
    {
        printf("%d",res[p]);
    }
    printf("\n");
    }
}
