#include<stdio.h>
int  isleap(int y)
{
    if((y%4==0 && y%100!=0)||(y%400==0))
        return 1;
return 0;
}
int getDay(int y,int m)
{
    if(m==1||m==3||m==5||m==7||m==8||m==10||m==12)
        return 31;
if(m==4||m==6||m==9||m==11)
    return 30;
if(isleap(y))
{
    return 29;
}
return 28;
}
int countDigit(int n,int target,int len)
{
    int cnt=0;
    for(int i=0;i<len;i++)
    {
        int digit=n%10;
        if(digit==target)
            cnt++;
        n=n/10;
    }
    return cnt;
}
int main()
{
    int y,m,x;
    while(scanf("%d %d %d",&y,&m,&x)!=EOF)
    {
        int total=0;
        int days=getDay(y,m);
        for(int d=1;d<=days;d++)
        {
            total+=countDigit(y,x,4);
            total+=countDigit(m,x,2);
            total+=countDigit(d,x,2);
        }
        printf("%d\n",total);
    }
}