#include<stdio.h>
int main()
{
    int n,k,m;
    scanf("%d %d %d",&n,&k,&m);
    int a[100];
    for(int i=0;i<n;i++)
    {
        a[i]=1;
    }
    int cur=k;
    int out=0;
    while(out<n-1)
    {
        int num=0;
        while(1)
        {
            if(a[cur]==1)
            {
                num++;
                if(num==m)
                    break;
            }
            cur=(cur+1)%n;
        }
        a[cur]=0;
        out++;
        cur=(cur+1)%n;
    }
    for(int i=0;i<n;i++)
    {
        if(a[i]==1)
        {
            printf("%d\n",i);
            break;
        }
    }
}